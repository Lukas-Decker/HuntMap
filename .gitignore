# Browser HAR captures. A HAR stores the full request headers of the session
# that recorded it, including the Cookie header, so these are never committed.
# Re-capture into the repo root when you need to re-run extract_wikigg_har.py.
*.har

# derived from the HAR, regenerate with the snippet in README section 1
har_extract/

# editor / OS
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# generated - regenerate with the tools in tools/
compare/*.json

# from the wiki.gg HARs, via extract_wikigg_har.py
sources/wikigg/*.json

# from the Hunt level files, via extract_cargo_pois.py
huntmap/experimental/*.json

# from the game language paks, via build_i18n.py
huntmap/i18n/ui.json

# python
__pycache__/
*.pyc
